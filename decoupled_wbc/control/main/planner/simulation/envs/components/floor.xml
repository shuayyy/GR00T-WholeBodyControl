<!-- Checkerboard floor, visual only (contype=0), same as assets/lab_scene.xml's lab_scene_floor. -->
<mujoco model="floor_component">
  <asset>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1=".1 .2 .3" rgb2=".2 .3 .4"/>
    <material name="grid" texture="grid" texrepeat="1 1" texuniform="true" reflectance=".2"/>
  </asset>
  <worldbody>
    <body name="lab_scene_floor" pos="0 0 0" euler="0 0 0">
      <geom name="floor" pos="0 0 0" size="0 0 .05" type="plane" material="grid" condim="3" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
